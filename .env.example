# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any real keys to version control.

# Public configuration (safe to expose in browser code)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# This browser app only needs the public URL + publishable/anon key.
# If you add server-only code, keep any secret key on the server and never
# prefix it with VITE_ (Vite exposes VITE_* variables to the browser).
